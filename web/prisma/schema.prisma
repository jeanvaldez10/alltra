// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("NEXT_PUBLIC_DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  full_name    String
  username     String   @unique
  email        String   @unique
  password     String
  roles        Int[]
  subscription Int
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  channels  String[] // Array of channel IDs (references Channel)
  createdAt DateTime @default(now())
}

model Channel {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  parent      String   @db.ObjectId // References Category ID
  pinned      String[] // Embedded Messages
  permissions Int[] // Array of permission numbers
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  by        String
  channel   String
  createdAt DateTime @default(now())
}
